# Leave blank for production: /api requests are served by same-origin Vercel Functions.
# For local Vite development, the app defaults to http://localhost:8787.
VITE_API_BASE_URL=

# Optional Cloudflare Turnstile public site key. The equivalent honeypot,
# signed form token, and PostgreSQL rate limits work when this is unset.
# VITE_TURNSTILE_SITE_KEY=
